# ===================================================
# SANGAMNERKAR AGRO BACKEND CONFIGURATION
# ===================================================

# 1. Supabase PostgreSQL Connection String
# Replace [YOUR-PASSWORD] and [YOUR-PROJECT-REF] with your Supabase credentials:
# (Settings -> Database -> Connection string -> URI / Nodejs / Python)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternatively, for connection pooler (recommended for serverless):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require

# 2. JWT Security
SECRET_KEY=sangamnerkar_agro_secure_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://papaya-churros-a95269.netlify.app","https://sangamnerkaragro.com"]
